APP_NAME=Cloud Image Processing Service
APP_VERSION=1.0.0
DEBUG=True

DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/image_service

JWT_SECRET_KEY=YOUR_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

MAX_FILE_SIZE_MB=10

AWS_ACCESS_KEY_ID=BACKBLAZE_KEY_ID
AWS_SECRET_ACCESS_KEY=BACKBLAZE_APPLICATION_KEY
AWS_REGION=YOUR_B2_REGION
AWS_S3_BUCKET_NAME=YOUR_BUCKET
AWS_S3_ENDPOINT_URL=https://s3.YOUR_REGION.backblazeb2.com